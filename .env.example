# Application
APP_NAME="ComptaPro Tunisia"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://comptapro.tn

# Timezone
APP_TIMEZONE="Africa/Tunis"
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_TN

# Base de données
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=comptapro
DB_USERNAME=comptapro
DB_PASSWORD=

# Cache & Sessions
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=.comptapro.tn
SESSION_SECURE_COOKIE=true

# Queue
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_CLIENT=phpredis

# Email
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@comptapro.tn
MAIL_FROM_NAME="${APP_NAME}"

# Filesystem
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ============================================
# TUNISIA SPECIFIC SETTINGS
# ============================================

# El Fatoora (Facturation Électronique Tunisie)
ELFATOORA_ENABLED=true
ELFATOORA_API_URL=https://api.elfatoora.gov.tn
ELFATOORA_API_KEY=
ELFATOORA_ENVIRONMENT=production
ELFATOORA_CERTIFICATE_PATH=storage/app/certificates/elfatoora/cert.pem
ELFATOORA_PRIVATE_KEY_PATH=storage/app/certificates/elfatoora/key.pem
ELFATOORA_TIMEOUT=30

# ============================================
# AI SERVICES
# ============================================

# Anthropic Claude (Assistant IA + Analyses)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096

# Google Cloud Vision (OCR)
GOOGLE_CLOUD_VISION_ENABLED=true
GOOGLE_CLOUD_VISION_KEY_PATH=storage/app/credentials/google-vision.json

# AWS Textract (OCR alternatif)
AWS_TEXTRACT_ENABLED=false
AWS_TEXTRACT_REGION=eu-west-1

# Azure Computer Vision (OCR alternatif)
AZURE_COMPUTER_VISION_ENABLED=false
AZURE_COMPUTER_VISION_KEY=
AZURE_COMPUTER_VISION_ENDPOINT=

# OCR Provider (google, aws, azure, tesseract)
OCR_PROVIDER=google
OCR_CONFIDENCE_THRESHOLD=0.85

# ============================================
# AUTOMATION SETTINGS
# ============================================

# Automatisation générale
AUTO_ACCOUNTING_ENABLED=true
AUTO_VALIDATION_ENABLED=true
AUTO_VALIDATION_THRESHOLD=0.90

# Workflows automatiques
AUTO_MONTHLY_WORKFLOW_ENABLED=true
AUTO_MONTHLY_WORKFLOW_DAY=25
AUTO_TAX_DECLARATIONS_ENABLED=true

# Notifications
AUTO_DEADLINE_ALERTS=true
AUTO_ANOMALY_ALERTS=true
AUTO_WORKFLOW_NOTIFICATIONS=true

# Rate Limiting IA
AI_RATE_LIMIT_ASSISTANT=60
AI_RATE_LIMIT_OCR=20
AI_RATE_LIMIT_ANALYSIS=30

# ============================================
# TUNISIA TAX RATES (2024)
# ============================================

# TVA
TVA_RATE_STANDARD=19
TVA_RATE_REDUCED_1=13
TVA_RATE_REDUCED_2=7
TVA_RATE_EXPORT=0

# CNSS
CNSS_RATE_EMPLOYEE=9.18
CNSS_RATE_EMPLOYER=16.57
CNSS_SALARY_CEILING=6000

# IRPP (barème progressif)
IRPP_BRACKET_1_MIN=0
IRPP_BRACKET_1_MAX=5000
IRPP_BRACKET_1_RATE=0

IRPP_BRACKET_2_MIN=5000.001
IRPP_BRACKET_2_MAX=20000
IRPP_BRACKET_2_RATE=26

IRPP_BRACKET_3_MIN=20000.001
IRPP_BRACKET_3_MAX=30000
IRPP_BRACKET_3_RATE=28

IRPP_BRACKET_4_MIN=30000.001
IRPP_BRACKET_4_MAX=50000
IRPP_BRACKET_4_RATE=32

IRPP_BRACKET_5_MIN=50000.001
IRPP_BRACKET_5_RATE=35

# Déductions IRPP
IRPP_DEDUCTION_CHIEF_OF_FAMILY=150
IRPP_DEDUCTION_SPOUSE=150
IRPP_DEDUCTION_CHILD_1=100
IRPP_DEDUCTION_CHILD_2=100
IRPP_DEDUCTION_CHILD_3=100
IRPP_DEDUCTION_CHILD_4=100

# IS
IS_RATE_STANDARD=25
IS_RATE_REDUCED=15
IS_RATE_HIGH=35

# Autres taxes
TFP_RATE_STANDARD=2
TFP_RATE_REDUCED=1
TCL_RATE=0.2
FOPROLOS_RATE=1

# ============================================
# BANKING
# ============================================

# Banques tunisiennes supportées
SUPPORTED_BANKS=STB,BIAT,BNA,UBCI,ATB,BT,BH,UIB,AB,Amen,BTE

# Import bancaire
BANK_IMPORT_AUTO_RECONCILIATION=true
BANK_IMPORT_CONFIDENCE_THRESHOLD=0.80

# ============================================
# SECURITY
# ============================================

# Sanctum
SANCTUM_STATEFUL_DOMAINS=comptapro.tn,www.comptapro.tn
SANCTUM_GUARD=web

# CORS
CORS_ALLOWED_ORIGINS=https://comptapro.tn,https://www.comptapro.tn
CORS_ALLOWED_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_ALLOWED_HEADERS=Content-Type,X-Auth-Token,Authorization,Origin,X-Requested-With

# Sessions
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Password
PASSWORD_TIMEOUT=10800

# ============================================
# PERFORMANCE
# ============================================

# Opcache
OPCACHE_ENABLE=1
OPCACHE_MEMORY_CONSUMPTION=256
OPCACHE_MAX_ACCELERATED_FILES=20000

# Upload
UPLOAD_MAX_FILESIZE=20M
POST_MAX_SIZE=20M
MAX_EXECUTION_TIME=300

# ============================================
# MONITORING & LOGGING
# ============================================

# Sentry (optionnel)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Telescope (dev only)
TELESCOPE_ENABLED=false

# Debug Bar (dev only)
DEBUGBAR_ENABLED=false

# ============================================
# BACKUPS
# ============================================

BACKUP_ENABLED=true
BACKUP_DESTINATION=local
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30

# ============================================
# NOTIFICATIONS
# ============================================

# Slack (optionnel)
SLACK_WEBHOOK_URL=

# Discord (optionnel)
DISCORD_WEBHOOK_URL=

# SMS (optionnel)
SMS_PROVIDER=
SMS_API_KEY=

# ============================================
# VITE
# ============================================

VITE_APP_NAME="${APP_NAME}"

# ============================================
# BELGIUM SPECIFIC SETTINGS
# ============================================

# Application Belgique
APP_NAME_BE="ComptaPro Belgium"
APP_URL_BE=https://comptapro.be
APP_TIMEZONE_BE="Europe/Brussels"
APP_LOCALE_BE=fr
SESSION_DOMAIN_BE=.comptapro.be

# ============================================
# BELGIUM TAX RATES (2024)
# ============================================

# TVA Belgique
VAT_BE_RATE_NORMAL=21
VAT_BE_RATE_INTERMEDIATE=12
VAT_BE_RATE_REDUCED=6
VAT_BE_RATE_ZERO=0

# ONSS (Sécurité Sociale)
ONSS_RATE_EMPLOYEE=13.07
ONSS_RATE_EMPLOYER_BASE=25.00
ONSS_RATE_EMPLOYER_AVERAGE=27.00
ONSS_SALARY_CEILING=

# Précompte Professionnel (barème progressif)
WITHHOLDING_TAX_BRACKET_1_MIN=0
WITHHOLDING_TAX_BRACKET_1_MAX=15200
WITHHOLDING_TAX_BRACKET_1_RATE=25

WITHHOLDING_TAX_BRACKET_2_MIN=15200.01
WITHHOLDING_TAX_BRACKET_2_MAX=26830
WITHHOLDING_TAX_BRACKET_2_RATE=40

WITHHOLDING_TAX_BRACKET_3_MIN=26830.01
WITHHOLDING_TAX_BRACKET_3_MAX=46440
WITHHOLDING_TAX_BRACKET_3_RATE=45

WITHHOLDING_TAX_BRACKET_4_MIN=46440.01
WITHHOLDING_TAX_BRACKET_4_RATE=50

# Déductions précompte
WITHHOLDING_TAX_DEDUCTION_DEPENDENT=1750
WITHHOLDING_TAX_DEDUCTION_DISABILITY=500
WITHHOLDING_TAX_MARRIED_REDUCTION=0.85

# Impôt des Sociétés
COMPANY_TAX_BE_RATE_NORMAL=25
COMPANY_TAX_BE_RATE_SME_REDUCED=20
COMPANY_TAX_BE_SME_THRESHOLD=100000
COMPANY_TAX_BE_SME_MIN_CAPITAL=61500
COMPANY_TAX_BE_SME_MIN_REMUNERATION=45000

# Déduction intérêts notionnels
NOTIONAL_INTEREST_RATE=3.2

# Pécule de vacances
HOLIDAY_PAY_SIMPLE_RATE=7.67
HOLIDAY_PAY_DOUBLE_RATE=92

# ============================================
# BELGIUM DECLARATIONS
# ============================================

# Périodicité TVA
VAT_BE_PERIOD_THRESHOLD=2500000
VAT_BE_DEFAULT_PERIOD=monthly
VAT_BE_DEADLINE_DAY=20

# Délais
ONSS_DECLARATION_DEADLINE_DAYS=31
COMPANY_TAX_FILING_MONTHS=7

# ============================================
# BELGIUM PCMN (Plan Comptable)
# ============================================

# Utiliser le PCMN au lieu du PCN
USE_PCMN=true

# Classes PCMN
PCMN_CLASS_EQUITY_LIABILITIES=1
PCMN_CLASS_FIXED_ASSETS=2
PCMN_CLASS_INVENTORY=3
PCMN_CLASS_CURRENT=4
PCMN_CLASS_FINANCIAL=5
PCMN_CLASS_EXPENSES=6
PCMN_CLASS_REVENUES=7
PCMN_CLASS_OFF_BALANCE=0

# ============================================
# BELGIUM BANKING
# ============================================

# Banques belges supportées
SUPPORTED_BANKS_BE=BNP_Paribas_Fortis,KBC,Belfius,ING,Argenta,Crelan,AXA_Bank,BeoBank,Triodos

# Format IBAN belge
IBAN_COUNTRY_CODE=BE
IBAN_LENGTH=16

# ============================================
# BELGIUM BNB REPORTING
# ============================================

# Banque Nationale de Belgique
BNB_REPORTING_ENABLED=true
BNB_SCHEMA_VERSION=2024
BNB_COMPANY_NUMBER=

# ============================================
# BELGIUM MULTILINGUAL
# ============================================

# Support multilingue Belgique
MULTILINGUAL_BE=true
SUPPORTED_LOCALES_BE=fr,nl,en
DEFAULT_LOCALE_BE=fr

# Champs multilingues dans PCMN
PCMN_MULTILINGUAL_NAMES=true
